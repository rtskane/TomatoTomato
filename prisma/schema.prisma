// Collaborative Cookbook — Phase 1 schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// A member's permission level within a single cookbook.
/// OWNER  – can delete the cookbook and manage members
/// EDITOR – can add/edit their own recipes
/// VIEWER – read-only
enum CookbookRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

/// How a cookbook's cover presents itself on the shelf.
/// TITLED – the cloth colour, with the title set in the serif inside a frame
/// PLAIN  – the cloth colour alone; the shelf label underneath names it
/// PHOTO  – the uploaded `coverImageUrl` fills the board
///
/// PHOTO is a *style*, not a synonym for "has an image": keeping the two apart
/// is what lets someone switch back to a colour without throwing their photo
/// away, and switch back to it later without re-uploading. The one rule is
/// that PHOTO with no image can't be rendered — `cookbookCoverSchema` folds
/// that combination back to TITLED rather than rejecting the save.
enum CoverStyle {
  TITLED
  PLAIN
  PHOTO
}

/// The weave printed on the cloth. Drawn from the cover's own ink at low
/// alpha, so it costs no new colour and works on all eight covers.
enum CoverTexture {
  NONE
  LINEN
  GRID
}

/// Which of the app's two families the cover title is set in. Deliberately not
/// a free font list: two families that already ship with the theme keep covers
/// looking like they belong to one shelf, and add no webfont to load.
enum CoverTitleFont {
  SERIF
  SANS
}

/// Sizes, not points. The rendered size is a percentage of the cover's own
/// width (see TITLE_SIZES in lib/book-covers.ts) — a cover has to read at
/// 240px on the shelf and 128px in the designer, so anything stored in pixels
/// would be wrong at one of them.
enum CoverTitleSize {
  SMALL
  MEDIUM
  LARGE
}

/// Where the title sits inside the frame. The frame itself doesn't move.
enum CoverTitlePosition {
  TOP
  CENTER
  BOTTOM
}

// ---------------------------------------------------------------------------
// Identity — keyed by clerkId. email/avatar are lazily synced from Clerk
// (see ensureUser); username/firstName/lastName are owned by our onboarding
// step. Everything else foreign-keys to this.
// ---------------------------------------------------------------------------

model User {
  id        String  @id @default(cuid())
  clerkId   String  @unique
  email     String  @unique
  // Profile — collected in our own onboarding step, NOT synced from Clerk.
  // `username` is null until onboarding completes; that null is the signal we
  // gate on to send a user through onboarding. (@unique allows many NULLs.)
  username  String? @unique
  firstName String?
  lastName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCookbooks  Cookbook[]       @relation("CookbookOwner")
  memberships     CookbookMember[]
  recipes         Recipe[]         @relation("RecipeAuthor")
  sentInvites     CookbookInvite[] @relation("InviteSender")
  receivedInvites CookbookInvite[] @relation("InviteRecipient")
}

// ---------------------------------------------------------------------------
// Cookbooks & collaboration
// ---------------------------------------------------------------------------

model Cookbook {
  id            String   @id @default(cuid())
  title         String
  description   String?
  coverImageUrl String?
  ownerId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Which of the eight covers in lib/book-covers.ts this cookbook wears,
  /// 1-based — or null for "nobody has chosen", in which case the colour is
  /// derived from the id instead.
  ///
  /// Nullable rather than defaulted because those two states are genuinely
  /// different: a null can be re-derived when the palette grows, a stored 3
  /// must survive it. Storing the derived value at creation time would freeze
  /// a colour nobody picked and make it indistinguishable from one somebody
  /// did.
  ///
  /// Not a foreign key or an enum: the palette is a presentation detail that
  /// lives in the theme, and the database has no business knowing what
  /// "Garnet" is. Out-of-range values are tolerated at render time (see
  /// `coverFor`) rather than constrained here.
  coverColor Int?

  /// Defaulted rather than nullable, because unlike the colour there is no
  /// useful "unset" — every cover has to render *somehow*, and TITLED is what
  /// every cookbook without a photo already looked like. The migration
  /// backfills existing rows that have a `coverImageUrl` to PHOTO so nobody's
  /// cover changes underneath them.
  coverStyle CoverStyle @default(TITLED)

  // ---- How the cover is composed -----------------------------------------
  //
  // Explicit typed columns rather than one `Json` blob, and that is a
  // deliberate trade. A blob would take fewer migrations to extend, but the
  // whole premise here is a *composed* cover, not a freeform one: the
  // vocabulary is finite by design, which is exactly what an enum is for. It
  // also means Prisma's types carry the vocabulary all the way to the JSX, and
  // a value that isn't in it can't be stored at all rather than being
  // discovered at render time.
  //
  // Every default below reproduces how covers looked before this existed, so
  // no cookbook changes appearance when the columns appear.

  coverTexture       CoverTexture       @default(NONE)
  coverTitleFont     CoverTitleFont     @default(SERIF)
  coverTitleSize     CoverTitleSize     @default(MEDIUM)
  coverTitlePosition CoverTitlePosition @default(CENTER)

  /// Which point of the photograph to keep when it is cropped to the book's
  /// 3:4, as fractions of the image (0–1, centre is 0.5/0.5), plus how far it
  /// is zoomed in (1 = fit).
  ///
  /// Fractions rather than pixels for the same reason the title size is an
  /// enum: the same cover is drawn at 240px, 128px and 36px, and a focal point
  /// in pixels would be a different part of the picture at each one. Stored on
  /// the cookbook rather than baked into the uploaded file so it stays
  /// adjustable forever and costs no re-upload.
  coverFocalX Float @default(0.5)
  coverFocalY Float @default(0.5)
  coverZoom   Float @default(1)

  /// Set when the owner archives the cookbook; null means live.
  ///
  /// Archiving is a *soft* delete, chosen over a real one because deleting a
  /// cookbook cascades to every recipe in it — including recipes other members
  /// wrote. Destroying someone else's work irreversibly, on one click, is not a
  /// thing this app should be able to do.
  ///
  /// The cost is that **every read of a cookbook has to exclude archived rows**,
  /// and missing one leaks a cookbook that its members believe is gone. The
  /// defence is architectural rather than vigilant: access is always resolved
  /// through `CookbookMember` (see cookbookRepository.create), so the filter
  /// lives on the membership lookups in one repository, not scattered across
  /// call sites. `archivedCookbook` in cookbook.repository is the single
  /// definition every one of those queries reuses.
  archivedAt DateTime?

  owner   User             @relation("CookbookOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members CookbookMember[]
  recipes Recipe[]
  invites CookbookInvite[]

  @@index([ownerId])
  // Archived cookbooks are read only by their owner, on the dashboard.
  @@index([ownerId, archivedAt])
}

model CookbookMember {
  id         String       @id @default(cuid())
  cookbookId String
  userId     String
  role       CookbookRole
  createdAt  DateTime     @default(now())

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cookbookId, userId])
  @@index([userId])
  @@index([cookbookId])
}

/// An invitation to join a cookbook. **No membership exists until the invitee
/// accepts** — that's what stops an unwanted invite from putting a cookbook in
/// someone's library.
///
/// ## Two ways to address one
///
/// `invitedUserId` is set when the invitee already has an account (they're
/// found by username, and see the invite in-app). `email` is set when they
/// don't yet (a link is sent to them). **Exactly one of the two is non-null** —
/// Prisma can't express a CHECK constraint, so `inviteRepository` is the
/// chokepoint that enforces it, via a discriminated union on its input.
///
/// ## One row per (cookbook, person)
///
/// Re-inviting someone *upserts* rather than inserting, so a second invite can
/// never stack a second notification — and a DECLINED row stays behind as the
/// record a future blocking feature can read. "One pending invite per person
/// per cookbook" would otherwise need a partial unique index (`WHERE status =
/// 'PENDING'`), which Prisma can't declare and which would drift on the next
/// `migrate dev`.
///
/// Postgres treats NULLs as distinct in unique indexes, so the two `@@unique`
/// rules below coexist: account-invites (email NULL) can only collide on the
/// first, email-invites (invitedUserId NULL) only on the second.
model CookbookInvite {
  id String @id @default(cuid())

  cookbookId String
  /// Set when the invitee has an account. Mutually exclusive with `email`.
  invitedUserId String?
  /// Set when they don't. Mutually exclusive with `invitedUserId`.
  email       String?
  role        CookbookRole @default(VIEWER)
  invitedById String
  /// Generated for every invite, including in-app ones. Costs nothing now and
  /// means any invite can become a shareable link once email delivery exists.
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  // @default(now()) as well as @updatedAt: the column was added to a table that
  // could already have rows, so it needed a database-level default to backfill.
  // Declaring it here keeps schema and database in agreement instead of leaving
  // that default looking like drift.
  updatedAt DateTime     @default(now()) @updatedAt

  cookbook    Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser User?    @relation("InviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([cookbookId, invitedUserId])
  @@unique([cookbookId, email])
  @@index([cookbookId])
  @@index([email])
  @@index([invitedUserId])
}

// ---------------------------------------------------------------------------
// Recipes — structured (ordered ingredients + steps)
// ---------------------------------------------------------------------------

model Recipe {
  id              String   @id @default(cuid())
  cookbookId      String
  authorId        String
  title           String
  description     String?
  servings        Int?
  prepTimeMinutes Int?
  cookTimeMinutes Int?
  coverImageUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cookbook    Cookbook     @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  author      User         @relation("RecipeAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  ingredients Ingredient[]
  steps       Step[]

  @@index([cookbookId])
  @@index([authorId])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  position Int
  name     String
  quantity Float?
  unit     String?
  note     String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Step {
  id          String @id @default(cuid())
  recipeId    String
  position    Int
  instruction String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}
